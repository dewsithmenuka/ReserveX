generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
}

model Resource {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(120)
  type        String   @db.VarChar(60)
  description String?  @db.VarChar(1000)
  location    String?  @db.VarChar(120)
  capacity    Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  reservations Reservation[]
  pricePerHourCents Int @default(0)

  @@index([type, isActive])
  @@index([name])
}

model Reservation {
  id              String            @id @default(uuid()) @db.Uuid
  resourceId      String            @db.Uuid
  reservedByName  String            @db.VarChar(120)
  reservedByEmail String            @db.VarChar(254)
  purpose         String            @db.VarChar(500)
  startAt         DateTime          @db.Timestamptz(3)
  endAt           DateTime          @db.Timestamptz(3)
  status          ReservationStatus @default(CONFIRMED)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@index([resourceId, startAt, endAt])
  @@index([status])
  @@index([startAt])
  amountCents   Int           @default(0)
  paymentStatus PaymentStatus @default(NOT_REQUIRED)
  payments      Payment[]
}
enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(254)
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  tokenVersion Int       @default(0)
  
  reservations Reservation[]
  payments Payment[]

}
enum PaymentStatus {
  NOT_REQUIRED
  UNPAID
  PAID
  REFUNDED
}

enum PaymentKind {
  CHARGE
  REFUND
}

enum PaymentResult {
  SUCCEEDED
  FAILED
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  reservationId String        @db.Uuid
  userId        String?       @db.Uuid
  kind          PaymentKind
  result        PaymentResult
  amountCents   Int
  currency      String        @default("LKR") @db.VarChar(3)
  cardBrand     String?       @db.VarChar(30)
  cardLast4     String?       @db.VarChar(4)
  failureReason String?       @db.VarChar(200)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([reservationId])
  @@index([userId, createdAt])
  @@index([createdAt])
}
model RateLimit {
  key       String   @id @db.VarChar(200)
  count     Int
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}